Module module() {
  module(name: "di", version: 7, exports: ["container"], dependencies: [
    dependency(repository: "norm", name: "java.base", version: 1),
    exportedDependency(repository: "github", name: "jakarta.inject", version: 9),
    exportedDependency(repository: "github", name: "jakarta.annotation", version: 7),
    exportedDependency(repository: "github", name: "micronaut.inject", version: 13),
    dependency(repository: "github", name: "micronaut.inject.processor", version: 11),
    dependency(repository: "github", name: "netty.buffer", version: 1)
  ])
}














